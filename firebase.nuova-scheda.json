{
  "hosting": {
    "site": "lg-nuova-scheda",
    "public": "apps/nuova-scheda/public",
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {"key":"Cache-Control","value":"no-cache"},
          {"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive"},
          {"key":"X-Content-Type-Options","value":"nosniff"},
          {"key":"X-Frame-Options","value":"DENY"},
          {"key":"Referrer-Policy","value":"no-referrer"},
          {"key":"Permissions-Policy","value":"camera=(), microphone=(self), geolocation=()"},
          {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; connect-src 'none'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action https://www.google.com; upgrade-insecure-requests"}
        ]
      }
    ]
  }
}
